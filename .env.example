# Copy to .env; the sender loads it from the working directory. Exported
# environment variables take precedence. Never commit real values.

# Fee payer: base58 secret key or the JSON byte array solana-keygen writes. It pays
# every fee and tip, so fund it with about a week of budget at a time.
SEND_BENCH_KEYPAIR=

# Trusted JSON-RPC for blockhashes, slots, statuses and block order. Never a path,
# and not from a provider that has one.
BENCH_REFERENCE_RPC_URL=

CLICKHOUSE_SEND_USER=replace-with-the-sender-clickhouse-user
CLICKHOUSE_SEND_PASSWORD=replace-with-the-sender-clickhouse-password

# One URL per path, named by url_env in config.example.yaml. URLs often embed API
# keys; the sender never logs them.
SEND_PATH_ALCHEMY_URL=
SEND_PATH_CHAINSTACK_URL=
SEND_PATH_FLUXRPC_URL=
SEND_PATH_HELIUS_URL=
SEND_PATH_QUICKNODE_URL=
SEND_PATH_SOLANAVIBESTATION_URL=
SEND_PATH_TRITON_URL=
SEND_PATH_JITO_URL=
